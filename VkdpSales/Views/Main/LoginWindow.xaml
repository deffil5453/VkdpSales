<Window x:Class="VkdpSales.Views.Main.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VkdpSales.Views.Main"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="400">
    <Grid>
        <!-- Декоративные элементы фона -->
        <Ellipse Width="400" Height="400" Fill="#2ECC71" Opacity="0.05" 
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-100,-100,0,0"/>
        <Ellipse Width="300" Height="300" Fill="#3498DB" Opacity="0.05" 
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-50"/>

        <!-- Карточка входа -->
        <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" Padding="40,35" CornerRadius="12"
                BorderBrush="#B8D8C8" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#2ECC71" BlurRadius="25" ShadowDepth="0" Opacity="0.12"/>
            </Border.Effect>

            <StackPanel>
                <!-- Заголовок -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,30">
                    <TextBlock Text="🏭 ВКДП" FontSize="28" FontWeight="Bold" 
                               Foreground="#1B4D3E" HorizontalAlignment="Center"/>
                    <TextBlock Text="Система учёта продаж" FontSize="13" 
                               Foreground="#4A7C6B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Поле логина -->
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="Логин" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" 
                             Height="42" Padding="12,0,0,0" FontSize="14"/>
                </StackPanel>

                <!-- Поле пароля -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Пароль" Style="{StaticResource LabelStyle}"/>
                    <PasswordBox x:Name="PasswordBox" Height="42" Padding="12,0,0,0" FontSize="14"/>
                </StackPanel>

                <!-- Сообщение об ошибке -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#E74C3C"
                           Margin="0,0,0,25" TextWrapping="Wrap" FontWeight="Medium"
                           TextAlignment="Center" FontSize="13"/>

                <!-- Кнопка входа -->
                <Button Content="Войти в систему" Command="{Binding LoginCommand}"
                        CommandParameter="{Binding ElementName=PasswordBox}"
                        Height="48" Style="{StaticResource GreenButton}"
                        FontSize="15" FontWeight="Bold" Margin="0,0,0,15"/>

                
            </StackPanel>
        </Border>
    </Grid>
</Window>
