<UserControl x:Class="VkdpSales.Views.UserControls.NewSaleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VkdpSales.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Выбор клиента -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Клиент:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Clients}"
                   SelectedItem="{Binding SelectedClient}"
                   Width="300" Height="30">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Панель добавления товара -->
        <Border Grid.Row="1" Padding="15" Background="#F8F9FA" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Товар:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Products}"
                           SelectedItem="{Binding SelectedProduct}"
                           Width="250" Height="30">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Кол-во:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="30"/>
                </StackPanel>
                <!--<StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Цена:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="100" Height="30" IsReadOnly="True"/>
                </StackPanel>-->
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="Скидка (%):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Width="80" Height="30"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <Button Content="➕ В корзину" Command="{Binding AddToCartCommand}" Width="120" Height="35" Background="#27AE60" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Корзина -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding CartItems}" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F5F5F5" GridLinesVisibility="Horizontal" CanUserAddRows="False" Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="2*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="0.5*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding UnitPrice, StringFormat={}{0:F2} ₽}" Width="0.8*"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding Discount, StringFormat={}{0:F0}%}" Width="0.5*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding LineTotal, StringFormat={}{0:F2} ₽}" Width="1*"/>
                <DataGridTemplateColumn Header="Действие" Width="0.8*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="🗑" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Width="30" Height="30" Background="#E74C3C" Foreground="White" Cursor="Hand"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итог и сохранение -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding Comment}" Padding="5" VerticalContentAlignment="Center" Height="35" Margin="0,0,15,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <TextBlock Text="Итого:" FontSize="14" FontWeight="Bold" Margin="0,0,5,0"/>
                <TextBlock Text="{Binding OrderTotal, StringFormat={}{0:F2} ₽}" FontSize="16" FontWeight="Bold" Foreground="#2C3E50"/>
            </StackPanel>
            <Button Grid.Column="2" Content="🗑 Очистить" Command="{Binding ClearCartCommand}" Width="120" Height="35" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" Cursor="Hand"/>
            <Button Grid.Column="3" Content="💾 Оформить заказ" Command="{Binding SaveOrderCommand}" Width="150" Height="35" Background="#2980B9" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
        </Grid>
    </Grid>
</UserControl>
