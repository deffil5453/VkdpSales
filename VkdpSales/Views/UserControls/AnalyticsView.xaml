<UserControl x:Class="VkdpSales.Views.UserControls.AnalyticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VkdpSales.Views.UserControls"
             mc:Ignorable="d" d:DesignWidth="900" Height="500">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора периода -->
        <Border Grid.Row="0" Padding="15" Background="#F8F9FA" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="С:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120" Height="30"/>
                </StackPanel>
                <StackPanel Margin="0,0,15,0">
                    <TextBlock Text="По:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="120" Height="30"/>
                </StackPanel>
                <Button Content="📊 Сформировать" Command="{Binding GenerateCommand}" 
                        Width="130" Height="35" Background="#2980B9" Foreground="White" 
                        FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Блок с общей выручкой -->
        <Border Grid.Row="1" Background="#E8F6F3" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💰 Общая выручка за период:" FontSize="14" FontWeight="Bold" Foreground="#145A32" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:F2} ₽}" FontSize="18" FontWeight="Bold" Foreground="#145A32"/>
            </StackPanel>
        </Border>

        <!-- Две таблицы рядом: Топ товаров и Менеджеры -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая таблица: Топ товаров -->
            <DataGrid Grid.Column="0" ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" 
                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Продано" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:F2} ₽}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Правая таблица: Эффективность менеджеров -->
            <DataGrid Grid.Column="2" ItemsSource="{Binding ManagerStats}" AutoGenerateColumns="False" 
                      IsReadOnly="True" AlternatingRowBackground="#F5F5F5" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Менеджер" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Заказов" Binding="{Binding OrdersCount}" Width="80"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:F2} ₽}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Статус и кнопка экспорта -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Статус выполнения -->
            <!--<TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#7F8C8D"/>-->

            <!-- Кнопка экспорта -->
            <Button Grid.Column="1" Content="📥 Экспорт в CSV" Command="{Binding ExportCommand}" 
                    Width="140" Height="35" Background="#8E44AD" Foreground="White" Cursor="Hand"/>
        </Grid>
    </Grid>
</UserControl>
