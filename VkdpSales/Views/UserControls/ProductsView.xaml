<UserControl x:Class="VkdpSales.Views.UserControls.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VkdpSales.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="800">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Фильтр -->
            <RowDefinition Height="*"/>
            <!-- Таблица (занимает всё место) -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- 🔹 Фильтр по категориям -->
        <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Categories}" 
              SelectedItem="{Binding SelectedCategory}" 
              Width="200" Height="30">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- 🔹 Таблица товаров (Теперь в Ячейке: Колонка 0, Строка 1) -->
        <DataGrid Grid.Column="0" Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
              AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F5F5F5" 
              GridLinesVisibility="Horizontal" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул" Binding="{Binding SKU}" Width="0.8*"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="0.5*"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding BasePrice, StringFormat={}{0:F2} ₽}" Width="0.8*"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding CurrentStock}" Width="0.6*"/>
                <DataGridTextColumn Header="Активен" Binding="{Binding IsActive}" Width="0.6*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма редактирования/добавления (Остается во 2-й колонке, растягивается на 2 строки) -->
        <Border Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Background="#F8F9FA" Padding="15" CornerRadius="5">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#2C3E50"/>

                <TextBlock Text="Артикул:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SKU}" Height="35" Margin="0,0,0,10"/>

                <TextBlock Text="Название:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Name}" Height="35" Margin="0,0,0,10"/>

                <TextBlock Text="Ед. измерения:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Unit}" Height="35" Margin="0,0,0,10"/>

                <TextBlock Text="Цена:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Price}" Height="35" Margin="0,0,0,10"/>

                <TextBlock Text="Остаток:" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Stock}" Height="35" Margin="0,0,0,10"/>

                <CheckBox Content="Товар активен" IsChecked="{Binding IsActive}" Margin="0,0,0,15"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Добавить" Command="{Binding AddCommand}" Width="80" Height="30" Margin="0,0,5,0" Background="#27AE60" Foreground="White"/>
                    <Button Content="Изменить" Command="{Binding EditCommand}" Width="80" Height="30" Background="#2980B9" Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Button Content="💾 Сохранить" Command="{Binding SaveCommand}" Width="90" Height="30" Margin="0,0,5,0" Background="#16A085" Foreground="White"/>
                    <Button Content="❌ Отмена" Command="{Binding CancelCommand}" Width="90" Height="30" Background="#7F8C8D" Foreground="White"/>
                </StackPanel>

                <Button Content="Удалить" 
                        Command="{Binding DeleteCommand}" 
                        Width="100" Height="30" 
                        Background="#C0392B" Foreground="White" 
                        Margin="0,10,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
