<UserControl x:Class="VkdpSales.Views.UserControls.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VkdpSales.Views.UserControls"
             mc:Ignorable="d" Width="1000" Height="450">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель фильтров -->
        <Border Grid.Row="0" Padding="15" Background="#F8F9FA" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="С:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="110" Height="28"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="По:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="110" Height="28"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Клиент:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Clients}" 
                          SelectedItem="{Binding SelectedClient}" Width="180" Height="35">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>

                    </ComboBox>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Статус:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" 
                          Width="100" Height="35"/>
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Поиск:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Width="150" Height="35"/>
                </StackPanel>
                <Button Content="🔍 Фильтр" Command="{Binding FilterCommand}" Width="100" Height="32" 
                    Background="#3498DB" Foreground="White" FontWeight="Bold" Margin="10,0,0,0" Cursor="Hand"/>
                <Button Content="🔄 Сброс" Command="{Binding RefreshCommand}" Width="90" Height="32" 
                    Background="#95A5A6" Foreground="White" Margin="10,0,0,0" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredOrders}" AutoGenerateColumns="False" 
              IsReadOnly="True" AlternatingRowBackground="#F5F5F5" GridLinesVisibility="Horizontal" 
              CanUserAddRows="False" RowHeight="35">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Заказа" Binding="{Binding OrderNumber}" Width="1.2*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy HH:mm}" Width="1.5*"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding Client.Name}" Width="2*"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="0.8*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:F2} ₽}" Width="1*"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
